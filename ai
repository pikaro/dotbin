    )


def argument_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description='Use speech, assistant, and language-model services.',
    )
    subparsers = parser.add_subparsers(
        dest='command',
        required=True,
        title='commands',
    )

    assist_parser = subparsers.add_parser(
        'assist',
        help='record or replay speech and play the assistant response',
        description='Record or replay speech and play the assistant response.',
    )
    add_wav_option(assist_parser)
    add_voice_option(assist_parser)
    add_service_options(
        assist_parser,
        default_url=DEFAULT_ASSIST_URL,
        url_environment='AI_ASSIST_URL',
        default_provider=DEFAULT_ASSIST_PROVIDER,
    )
    assist_parser.set_defaults(handler=run_assist_mode)

    stt_parser = subparsers.add_parser(
        'stt',
        help='transcribe microphone or WAV audio',
        description='Transcribe microphone or WAV audio.',
    )
    add_wav_option(stt_parser)
    add_service_options(
        stt_parser,
        default_url=DEFAULT_STT_URL,
        url_environment='AI_STT_URL',
        default_provider=DEFAULT_STT_PROVIDER,
    )
    stt_parser.set_defaults(handler=run_stt_mode)

    tts_parser = subparsers.add_parser(
        'tts',
        help='synthesize and play text as speech',
        description='Synthesize and play text as speech.',
    )
    add_voice_option(tts_parser)
    tts_parser.add_argument('text', metavar='TEXT', help='text to speak')

    tts_parser.add_argument(
        '--model',
        default=DEFAULT_TTS_MODEL,
        metavar='MODEL',
        help='model name (default: %(default)s)',
    )
    add_service_options(
        tts_parser,
        default_url=DEFAULT_TTS_URL,
        url_environment='AI_TTS_URL',
        default_provider=DEFAULT_TTS_PROVIDER,
    )
    tts_parser.set_defaults(handler=run_tts_mode)

    tts_multi_parser = subparsers.add_parser(
        'tts-multi',
        help='synthesize and play a sequence with multiple speakers',
        description='Synthesize and play a sequence with multiple speakers.',
        epilog=(
            'example: ai tts-multi --speaker narrator=attenborough '
            '--speaker bandit=bender bandit "Bite my shiny" '
            'attenborough "... metal ass"'
        ),
    )
    tts_multi_parser.add_argument(
        '--speaker',
        dest='speakers',
        action='append',
        required=True,
        type=speaker_assignment,
        metavar='NAME=VOICE',
        help='declare a speaker and voice; repeat for each speaker',
    )
    tts_multi_parser.add_argument(
        'segments',
        nargs='+',
        metavar='SPEAKER/TEXT',
        help=('alternating SPEAKER TEXT pairs; SPEAKER may be a declared name or unique voice'),
    )
    tts_multi_parser.add_argument(
        '--model',
        default=DEFAULT_TTS_MODEL,
        metavar='MODEL',
        help='model name (default: %(default)s)',
    )
    add_service_options(
        tts_multi_parser,
        default_url=DEFAULT_TTS_MULTI_URL,
        url_environment='AI_TTS_MULTI_URL',
        default_provider=DEFAULT_TTS_PROVIDER,
    )
    tts_multi_parser.set_defaults(handler=run_tts_multi_mode)

    llm_parser = subparsers.add_parser(
        'llm',
        help='send a prompt to a chat-completion model',
        description='Send a prompt to a chat-completion model.',
    )
    llm_parser.add_argument('prompt', metavar='PROMPT', help='user prompt')
    llm_parser.add_argument(
        '--system',
        metavar='TEXT',
        help='system prompt',
    )
    llm_parser.add_argument(
        '--model',
        default=DEFAULT_LLM_MODEL,
        metavar='MODEL',
        help='model name (default: %(default)s)',
    )
    add_service_options(
        llm_parser,
        default_url=DEFAULT_LLM_URL,
        url_environment='AI_LLM_URL',
        default_provider=DEFAULT_LLM_PROVIDER,
    )
    llm_parser.set_defaults(handler=run_llm_mode)

    return parser


def main(arguments: list[str] | None = None) -> None:
    options = argument_parser().parse_args(arguments)
    handler: Callable[[argparse.Namespace], None] = options.handler
    handler(options)


if __name__ == '__main__':
    try:
        main()
    except AiError as error:
        print(f'Error: {error}', file=sys.stderr)
        raise SystemExit(1) from error
    except KeyboardInterrupt:
        raise SystemExit(130) from None
